PORT=4000
MONGO_URI=mongodb://mongo:27017/compliance_manager
JWT_SECRET=change-me-in-every-real-environment
JWT_EXPIRES_IN=8h
NODE_ENV=development

# Evidence storage: 'filesystem' (default, on-prem) or 's3' (cloud)
STORAGE_BACKEND=filesystem
EVIDENCE_STORAGE_DIR=./evidence-storage
EVIDENCE_MAX_SIZE_BYTES=26214400
# S3-compatible settings (only used when STORAGE_BACKEND=s3; S3_ENDPOINT for MinIO/non-AWS)
S3_BUCKET=compliance-manager-evidence
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
